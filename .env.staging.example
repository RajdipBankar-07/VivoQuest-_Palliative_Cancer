# ==============================================================================
# VivoQuest Staging Environment Configuration Template
# Safe for version control — Contains NO production secrets or real API credentials.
# ==============================================================================

# Node Environment & Isolated Staging Ports
NODE_ENV=staging
PORT=4001
API_BASE_URL=http://localhost:4001
WEB_APP_URL=http://localhost:3001

# Staging Authentication & Security
# Cryptographically random staging secret — isolated from production and dev
JWT_SECRET=vivoquest_staging_jwt_secret_isolated_sec_key_2026
JWT_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=7d

# Primary Staging Database: Completely isolated from vivoquest_db
MONGODB_URI=mongodb://127.0.0.1:27017/vivoquest_staging_db
MONGODB_DB_NAME=vivoquest_staging_db

# Staging CORS: Approved Staging Origins Only
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,https://staging.vivoquest.com,https://admin-staging.vivoquest.com

# Staging Storage: MOCK or Isolated Staging S3 Bucket
STORAGE_PROVIDER=MOCK
AWS_REGION=ap-south-1
AWS_S3_BUCKET=vivoquest-staging-clinical-storage

# Payments: STRICTLY ENFORCED TEST MODE ONLY
RAZORPAY_KEY_ID=rzp_test_staging_sandbox_key
RAZORPAY_KEY_SECRET=staging_sandbox_secret_key
RAZORPAY_WEBHOOK_SECRET=staging_webhook_secret_key

# Strict Staging Security Controls
ALLOW_DEV_MOCK_OTP=false
AUTH_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_MAX=20

# Mobile Staging Client API Base Target
EXPO_PUBLIC_API_URL=http://localhost:4001/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001

# ==============================================================================
# VivoQuest Environment Variables Template
# Copy this file to .env and populate with local or sandbox values.
# NEVER commit real credentials, Atlas passwords, or production secrets.
# ==============================================================================

# Node Environment & Server Configuration
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=replace_with_cryptographically_secure_random_string_in_production
JWT_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=7d

# Primary Database: MongoDB Atlas (or local MongoDB 8.x)
# For local MongoDB: mongodb://localhost:27017/vivoquest_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/vivoquest_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/vivoquest_db
MONGODB_DB_NAME=vivoquest_db

# Image & Document Storage: AWS S3 (or S3-compatible MinIO)
STORAGE_PROVIDER=S3
AWS_REGION=ap-south-1
AWS_S3_BUCKET=vivoquest-dev-clinical-storage
AWS_ACCESS_KEY_ID=mock_aws_access_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret_key
AWS_KMS_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/mock-kms-uuid
S3_PRESIGNED_UPLOAD_TTL_SECONDS=900
S3_PRESIGNED_DOWNLOAD_TTL_SECONDS=900

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379

# AI & Optimization Microservice (Python FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=mock_ai_service_token_for_local_dev

# Geolocation & Traffic APIs (Sandbox / Dev Placeholders)
MAPBOX_ACCESS_TOKEN=pk.mock_mapbox_token_placeholder
GOOGLE_MAPS_API_KEY=mock_google_maps_key_placeholder

# Omnichannel Communications (Sandbox / Dev Placeholders)
GUPSHUP_WHATSAPP_API_KEY=mock_gupshup_whatsapp_key
GUPSHUP_APP_NAME=vivoquest_sandbox
TWILIO_ACCOUNT_SID=mock_twilio_sid
TWILIO_AUTH_TOKEN=mock_twilio_token
TWILIO_PHONE_NUMBER=+15005550006

# Payments & Disbursements (Razorpay Sandbox)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key

# ABDM / DigiLocker Sandbox Integrations
ABDM_CLIENT_ID=mock_abdm_sandbox_client_id
ABDM_CLIENT_SECRET=mock_abdm_sandbox_client_secret
ABDM_BASE_URL=https://dev.abdm.gov.in
